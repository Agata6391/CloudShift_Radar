{
  "name": "@cloudshift-radar/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "check:bob": "bob --accept-license --auth-method api-key -p \"Say OK\""
  },
  "dependencies": {
    "@cloudshift-radar/shared": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "undici": "^6.21.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}