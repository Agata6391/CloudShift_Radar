# ============================================
# Cloud_Radar Environment Configuration
# ============================================
# This file contains all required environment variables for Cloud_Radar.
# Copy this file to .env and update with your actual values.

# ============================================
# IBM Bob AI Configuration
# ============================================

# Bob provider type (currently only 'shell' is supported)
BOB_PROVIDER=shell

# Your IBM Bob API key with Inference scope
# IMPORTANT: Replace with your actual API key from IBM Bob
BOBSHELL_API_KEY=your_api_key_here

# Bob Shell command path
# Windows: Use the full path to bob executable
#   Example: C:/Users/YourUser/AppData/Roaming/npm/bob.cmd
#   Example: ./node_modules/.bin/bob
# Linux/macOS: Use 'bob' if installed globally, or './node_modules/.bin/bob'
#   Example: bob
#   Example: ./node_modules/.bin/bob
BOB_SHELL_COMMAND=./node_modules/.bin/bob

# Bob AI timeout in milliseconds (10 minutes recommended)
# Increase if you're analyzing large repositories or experiencing timeouts
# Recommended: 600000 (10 minutes)
BOB_TIMEOUT_MS=600000

# ============================================
# Server Configuration
# ============================================

# Backend API server port
PORT=4000

# Frontend URL for CORS configuration
# Update if running frontend on a different port or domain
FRONTEND_URL=http://localhost:5173